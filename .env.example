APP_NAME=VIO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Must match how you open the app (Filament/Livewire use this for CSS/JS URLs).
# php artisan serve: http://127.0.0.1:8000
# XAMPP (Apache, document root htdocs): http://localhost/vio/public
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# file avoids DB session locks during long Fetch/Process (esp. php artisan serve).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="administration@greenlease.com"
MAIL_FROM_NAME="Sit&Go cars rent"
MAIL_REPLY_TO_ADDRESS=administration@greenlease.com
O365_MAIL_ENABLED=true
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=

# Filament operators (ProductionUsersSeeder / vio:cloud-deploy)
# Laravel Cloud Variables: value WITHOUT quotes. Read via config/vio.php (config:cache safe).
VIO_BOOTSTRAP_PASSWORD=
# Set true only when you intentionally want to reset all seeded users' passwords.
VIO_BOOTSTRAP_RESET_PASSWORDS=false
# Laravel Cloud Deploy commands (recommended):
#   php artisan vio:cloud-deploy
VIO_INBOX_MAILBOX=administration@greenlease.lt
VIO_EMAIL_SUBJECT="Violation notification"

SHAREPOINT_SITE_URL=https://greenlease.sharepoint.com/sites/Saugykla
SHAREPOINT_FOLDER_PATH="Lithuania/Administration/Policijos administravimas"

DEBT_TRACKER_GOOGLE_URL="https://docs.google.com/spreadsheets/d/1oQr8h3ecQHguDv03sm34YQ649fjrWnr_7awVHFub7LU/edit#gid=1707280998"
DEBT_TRACKER_SHAREPOINT_URL=
DEBT_TRACKER_SHEET="LT debt"
DEBT_TRACKER_FILE_NAME=CHARGEBACKS-DEBTS.xlsx

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHEELSYS_BASE_URL=https://lt.wheelsys.greenmotion.com
WHEELSYS_RETURN_URL=/ui/dashboards/dailyview.aspx
WHEELSYS_IMPORT_PATH=/ui/manage/tasks/import.aspx
WHEELSYS_USERNAME=
WHEELSYS_PASSWORD=
WHEELSYS_MANUAL_USERNAME=
WHEELSYS_MANUAL_PASSWORD=
WHEELSYS_DEFAULT_TICKET_TYPE="Administration violation"
WHEELSYS_DEFAULT_STATION=MAIN
WHEELSYS_DEFAULT_TICKET_STATE=Open

# MarkSign (same account/token as pakaitinis)
MARKSIGN_TOKEN=
MARKSIGN_BASE_URL=https://api.marksign.eu
MARKSIGN_SIGNER_EMAIL=mykolas@sitandgo.lt
MARKSIGN_SIGNER_NAME="Mykolas Sabaitis"

# Same OCR.space key as Futura/SS (scanned ANR PDFs).
OCR_SPACE_API_KEY=
